@model RUNE.Models.Game
@{
    ViewData["Title"] = "Oyunu Düzenle";
}

<style>
    .create-page {
        max-width: 1150px;
        margin: auto;
        color: #f5f5f5;
    }

    .create-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .create-header h1 {
        font-size: 27px;
        font-weight: 750;
        margin: 0 0 8px;
    }

    .create-header p {
        color: #888;
        font-size: 13px;
        margin: 0;
    }

    .back-link {
        color: #aaa;
        font-size: 13px;
        text-decoration: none;
    }

    .form-section {
        background: #141414;
        border: 1px solid #292929;
        border-radius: 10px;
        padding: 27px;
        margin-bottom: 22px;
    }

    .section-header {
        margin-bottom: 25px;
        padding-bottom: 17px;
        border-bottom: 1px solid #292929;
    }

    .section-header h2 {
        font-size: 16px;
        margin: 0 0 7px;
    }

    .section-header p {
        color: #888;
        font-size: 12px;
        margin: 0;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 9px;
        min-width: 0;
    }

    .form-group.full {
        grid-column: 1 / -1;
    }

    .form-group label {
        color: #ddd;
        font-size: 12px;
        font-weight: 650;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 13px 14px;
        background: #1e1e1e;
        border: 1px solid #333;
        border-radius: 7px;
        color: #fff;
        font-size: 13px;
        outline: none;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: #888;
    }

    .form-group textarea {
        min-height: 130px;
        resize: vertical;
    }

    .media-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .media-card {
        min-width: 0;
        padding: 19px;
        background: #191919;
        border: 1px solid #303030;
        border-radius: 9px;
    }

    .media-card h3 {
        font-size: 13px;
        margin: 0 0 15px;
    }

    .current-image {
        width: 100%;
        max-height: 190px;
        object-fit: contain;
        background: #101010;
        border: 1px solid #333;
        border-radius: 7px;
        margin-bottom: 15px;
    }

    .current-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
    }

    .gallery-item {
        padding: 8px;
        background: #202020;
        border: 1px solid #333;
        border-radius: 7px;
        min-width: 0;
    }

    .gallery-item img {
        display: block;
        width: 100%;
        height: 90px;
        object-fit: cover;
        border-radius: 5px;
        margin-bottom: 8px;
    }

    .gallery-item span {
        color: #aaa;
        font-size: 10px;
        overflow-wrap: anywhere;
    }

    .media-input {
        margin-top: 14px;
    }

    .media-input label {
        display: block;
        margin-bottom: 8px;
        color: #aaa;
        font-size: 11px;
        font-weight: 600;
    }

    .media-input input,
    .media-input textarea {
        width: 100%;
        padding: 12px;
        background: #202020;
        border: 1px solid #333;
        border-radius: 7px;
        color: #fff;
        font-size: 12px;
    }

    .media-input textarea {
        min-height: 85px;
        resize: vertical;
    }

    .genre-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .genre-item {
        padding: 8px 12px;
        background: #292929;
        border: 1px solid #383838;
        border-radius: 6px;
        color: #ddd;
        font-size: 11px;
    }

    .form-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 15px 0 35px;
    }

    .form-footer p {
        color: #777;
        font-size: 11px;
    }

    .footer-buttons {
        display: flex;
        gap: 10px;
    }

    .form-button {
        padding: 13px 20px;
        border: none;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }

    .cancel-button {
        background: #292929;
        color: #ddd;
    }

    .save-button {
        background: #fff;
        color: #111;
    }

    .save-button:hover {
        background: #ddd;
    }

    @@media (max-width: 750px) {

        .form-grid,
        .media-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full {
            grid-column: auto;
        }

        .create-header,
        .form-footer {
            align-items: flex-start;
            flex-direction: column;
        }

        .form-section {
            padding: 19px;
        }

        .footer-buttons {
            width: 100%;
        }

        .form-button {
            flex: 1;
            text-align: center;
        }
    }

    .genre-picker {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .genre-picker label {
        display: block;
        margin-bottom: 8px;
        color: #ddd;
        font-size: 12px;
        font-weight: 650;
    }

    #genreSearch {
        width: 100%;
        padding: 13px 14px;
        background: #1e1e1e;
        border: 1px solid #333;
        border-radius: 7px;
        color: #fff;
        outline: none;
        font-size: 13px;
    }

    #genreSearch:focus {
        border-color: #888;
    }

    .genre-options {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        padding: 15px;
        background: #191919;
        border: 1px solid #303030;
        border-radius: 8px;
        max-height: 220px;
        overflow-y: auto;
    }

    .genre-option {
        padding: 9px 12px;
        background: #252525;
        border: 1px solid #383838;
        border-radius: 6px;
        color: #aaa;
        font-size: 11px;
        cursor: pointer;
        transition: .2s;
    }

    .genre-option:hover {
        background: #333;
        color: #fff;
    }

    .genre-option.selected {
        background: #fff;
        border-color: #fff;
        color: #111;
    }

    .selected-genre-heading {
        margin-top: 8px;
        color: #aaa;
        font-size: 11px;
        font-weight: 700;
    }

    .selected-genres {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        min-height: 34px;
    }

    .genre-chip {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 8px 11px;
        background: #292929;
        border: 1px solid #414141;
        border-radius: 6px;
        color: #eee;
        font-size: 11px;
    }

    .genre-chip button {
        border: none;
        background: transparent;
        color: #999;
        font-size: 17px;
        line-height: 1;
        cursor: pointer;
    }

    .genre-chip button:hover {
        color: #ff7777;
    }

    .genre-empty {
        color: #888;
        font-size: 12px;
    }


    .multi-picker {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 0;
    }

    .multi-picker>label {
        color: #ddd;
        font-size: 12px;
        font-weight: 650;
    }

    .picker-search {
        width: 100%;
        padding: 13px 14px;
        background: #1e1e1e;
        border: 1px solid #333;
        border-radius: 7px;
        color: #fff;
        font-size: 13px;
        outline: none;
        transition: .2s;
    }

    .picker-search:focus {
        border-color: #888;
        background: #222;
    }

    .picker-search::placeholder {
        color: #707070;
    }

    .picker-options {
        display: flex;
        flex-wrap: wrap;
        align-content: flex-start;
        gap: 8px;
        min-height: 58px;
        max-height: 180px;
        overflow-y: auto;
        padding: 12px;
        background: #191919;
        border: 1px solid #303030;
        border-radius: 8px;
    }

    .picker-option {
        padding: 8px 11px;
        background: #252525;
        border: 1px solid #383838;
        border-radius: 6px;
        color: #aaa;
        font-size: 11px;
        cursor: pointer;
        transition: .2s;
    }

    .picker-option:hover {
        background: #333;
        color: #fff;
        border-color: #555;
    }

    .picker-option.selected {
        background: #fff;
        border-color: #fff;
        color: #111;
    }

    .picker-selected-title {
        margin-top: 5px;
        color: #aaa;
        font-size: 11px;
        font-weight: 700;
    }

    .picker-selected {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        min-height: 28px;
    }

    .picker-chip {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 7px 10px;
        background: #292929;
        border: 1px solid #414141;
        border-radius: 6px;
        color: #eee;
        font-size: 11px;
    }

    .picker-chip button {
        padding: 0;
        border: 0;
        background: transparent;
        color: #999;
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
    }

    .picker-chip button:hover {
        color: #ff7777;
    }

    .picker-empty {
        width: 100%;
        color: #777;
        font-size: 11px;
        padding: 5px 2px;
    }
</style>

<div class="create-page">

    <div class="create-header">
        <div>
            <h1>Oyunu Düzenle</h1>
            <p>@Model.Title oyununa ait bilgileri güncelle.</p>
        </div>

        <a asp-area="Admin" asp-controller="Games" asp-action="Index" class="back-link">
            ← Oyunlara dön
        </a>
    </div>

    <form asp-area="Admin" asp-controller="Games" asp-action="Edit" asp-route-id="@Model.Id" method="post"
          enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>

        <input type="hidden" asp-for="Id" />

        <!-- Genel bilgiler -->
        <section class="form-section">

            <div class="section-header">
                <h2>Genel Bilgiler</h2>
                <p>Oyunun temel bilgilerini düzenle.</p>
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="Title">Oyun Adı</label>
                    <input asp-for="Title" />
                </div>

                <div class="form-group">
                    <label asp-for="Slug">Slug</label>
                    <input asp-for="Slug" />
                </div>

                <div class="form-group">
                    <label asp-for="Developer">Geliştirici</label>
                    <input asp-for="Developer" />
                </div>

                <div class="form-group">
                    <label asp-for="Publisher">Yayıncı</label>
                    <input asp-for="Publisher" />
                </div>

                <div class="form-group full">
                    <label asp-for="Description">Oyun Açıklaması</label>
                    <textarea asp-for="Description"></textarea>
                </div>

            </div>
        </section>

        <!-- Fiyat ve Yayın -->
        <section class="form-section">

            <div class="section-header">
                <h2>Fiyat ve Yayın Bilgileri</h2>
                <p>Oyunun fiyatını ve yayın durumunu düzenle.</p>
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="Price">Fiyat (₺)</label>
                    <input asp-for="Price" type="number" step="0.01" min="0" />
                </div>

                <div class="form-group">
                    <label asp-for="ReleaseDate">Çıkış Tarihi</label>
                    <input asp-for="ReleaseDate" type="date" />
                </div>

                <div class="form-group">
                    <label asp-for="DisplayOrder">Görüntülenme Sırası</label>
                    <input asp-for="DisplayOrder" type="number" min="0" />
                </div>

                <div class="form-group">
                    <label asp-for="IsPublished">Yayın Durumu</label>
                    <select asp-for="IsPublished">
                        <option value="false">Taslak</option>
                        <option value="true">Yayında</option>
                    </select>
                </div>

            </div>
        </section>

        <!-- Türler ve Etiketler -->
        <section class="form-section">

            <div class="section-header">
                <h2>Kategoriler ve Oyun Özellikleri</h2>
                <p>Oyunun türlerini ve etiketlerini birbirinden bağımsız seç veya kaldır.</p>
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <div class="multi-picker" data-picker="genres">
                        <label for="genreSearch">Oyun Türleri</label>

                        <input type="search" id="genreSearch" class="picker-search" placeholder="Oyun türü ara..."
                               autocomplete="off" />

                        <div class="picker-options" id="genreOptions"></div>

                        <div class="picker-selected-title">Seçilen Türler</div>
                        <div class="picker-selected" id="selectedGenres"></div>

                        <select id="genreSelectSource" name="genreIds" asp-items="ViewBag.Genres" multiple hidden>
                        </select>

                        <small>Türleri listeden seçebilir veya seçimin yanındaki × ile kaldırabilirsin.</small>
                    </div>
                </div>

                <div class="form-group">
                    <div class="multi-picker" data-picker="tags">
                        <label for="tagSearch">Oyun Etiketleri</label>

                        <input type="search" id="tagSearch" class="picker-search" placeholder="Etiket ara..."
                               autocomplete="off" />

                        <div class="picker-options" id="tagOptions"></div>

                        <div class="picker-selected-title">Seçilen Etiketler</div>
                        <div class="picker-selected" id="selectedTags"></div>

                        <select id="tagSelectSource" name="tagIds" asp-items="ViewBag.Tags" multiple hidden>
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <!-- Kapak ve Banner -->
        <section class="form-section">

            <div class="section-header">
                <h2>Mağaza Görselleri</h2>
                <p>Mevcut kapak ve banner görsellerini incele veya değiştir.</p>
            </div>

            <div class="media-grid">

                <div class="media-card">
                    <h3>Kapak Görseli</h3>

                    @if (!string.IsNullOrWhiteSpace(Model.CoverImagePath))
                    {
                        <img src="@Model.CoverImagePath" class="current-image" alt="Mevcut kapak görseli" />
                    }
                    else
                    {
                        <p style="color:#888;font-size:12px;">
                            Kapak görseli bulunmuyor.
                        </p>
                    }

                    <div class="media-input">
                        <label for="CoverImageFile">Yeni kapak dosyası</label>
                        <input type="file" id="CoverImageFile" name="CoverImageFile"
                               accept="image/jpeg,image/png,image/webp" />
                    </div>

                    <div class="media-input">
                        <label asp-for="CoverImagePath">Kapak URL</label>
                        <input asp-for="CoverImagePath" type="url" />
                    </div>
                </div>

                <div class="media-card">
                    <h3>Banner Görseli</h3>

                    @if (!string.IsNullOrWhiteSpace(Model.BannerImagePath))
                    {
                        <img src="@Model.BannerImagePath" class="current-image" alt="Mevcut banner görseli" />
                    }
                    else
                    {
                        <p style="color:#888;font-size:12px;">
                            Banner görseli bulunmuyor.
                        </p>
                    }

                    <div class="media-input">
                        <label for="BannerImageFile">Yeni banner dosyası</label>
                        <input type="file" id="BannerImageFile" name="BannerImageFile"
                               accept="image/jpeg,image/png,image/webp" />
                    </div>

                    <div class="media-input">
                        <label asp-for="BannerImagePath">Banner URL</label>
                        <input asp-for="BannerImagePath" type="url" />
                    </div>
                </div>

            </div>
        </section>

        <!-- Galeri -->
        <section class="form-section">

            <div class="section-header">
                <h2>Ekran Görüntüleri</h2>
                <p>Oyuna ait mevcut galeri görselleri.</p>
            </div>

            @if (Model.Images.Any())
            {
                <div class="current-gallery">
                    @foreach (var image in Model.Images.OrderBy(x => x.DisplayOrder))
                    {
                        <div class="gallery-item">
                            <img src="@image.ImageUrl" alt="Oyun ekran görüntüsü" />
                            <span>@image.ImageType</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color:#888;font-size:12px;">
                    Henüz galeri görseli eklenmemiş.
                </p>
            }

            <div class="media-input">
                <label for="GalleryImages">Yeni ekran görüntüleri</label>
                <input type="file" id="GalleryImages" name="GalleryImages" accept="image/jpeg,image/png,image/webp"
                       multiple />
            </div>

            <div class="media-input">
                <label for="GalleryImageUrls">Yeni görsel URL'leri</label>
                <textarea id="GalleryImageUrls" name="GalleryImageUrls"
                          placeholder="Her satıra bir görsel URL'si gir."></textarea>
            </div>

        </section>

        <!-- Videolar -->
        <section class="form-section">

            <div class="section-header">
                <h2>Fragman ve Videolar</h2>
                <p>Oyuna ait mevcut video kayıtları.</p>
            </div>

            @if (Model.Videos.Any())
            {
                @foreach (var video in Model.Videos.OrderBy(x => x.DisplayOrder))
                {
                    <div class="media-card" style="margin-bottom:12px;">
                        <h3>@video.Title</h3>
                        <a href="@video.VideoUrl" target="_blank" rel="noopener noreferrer" style="color:#aaa;font-size:12px;">
                            Videoyu görüntüle
                        </a>
                    </div>
                }
            }
            else
            {
                <p style="color:#888;font-size:12px;">
                    Henüz fragman veya video eklenmemiş.
                </p>
            }

            <div class="media-grid" style="margin-top:20px;">

                <div class="media-card">
                    <h3>Yeni Video Dosyaları</h3>
                    <input type="file" name="TrailerFiles" accept="video/mp4,video/webm" multiple />
                </div>

                <div class="media-card">
                    <h3>Yeni Video URL'leri</h3>
                    <textarea name="TrailerUrls" placeholder="Her satıra bir video URL'si gir."></textarea>
                </div>

            </div>

        </section>

        <!-- Sistem Gereksimleri -->
        <section class="form-section">

            <div class="section-header">
                <h2>Sistem Gereksinimleri</h2>
                <p>Oyunun minimum ve önerilen sistem özelliklerini düzenle.</p>
            </div>

            <div class="system-requirements">

                <div class="requirement-card">
                    <h3>Minimum Gereksinimler</h3>

                    <div class="form-grid">

                        <div class="form-group">
                            <label>İşletim Sistemi</label>
                            <input asp-for="SystemRequirement.MinimumOS" placeholder="Windows 10" />
                        </div>

                        <div class="form-group">
                            <label>İşlemci</label>
                            <input asp-for="SystemRequirement.MinimumProcessor" placeholder="Intel Core i5..." />
                        </div>

                        <div class="form-group">
                            <label>Bellek (RAM)</label>
                            <input asp-for="SystemRequirement.MinimumMemory" placeholder="8 GB RAM" />
                        </div>

                        <div class="form-group">
                            <label>Ekran Kartı</label>
                            <input asp-for="SystemRequirement.MinimumGraphics" placeholder="GTX 1060..." />
                        </div>

                        <div class="form-group">
                            <label>Depolama</label>
                            <input asp-for="SystemRequirement.MinimumStorage" placeholder="70 GB" />
                        </div>

                    </div>
                </div>

                <div class="requirement-card">
                    <h3>Önerilen Gereksinimler</h3>

                    <div class="form-grid">

                        <div class="form-group">
                            <label>İşletim Sistemi</label>
                            <input asp-for="SystemRequirement.RecommendedOS" placeholder="Windows 11" />
                        </div>

                        <div class="form-group">
                            <label>İşlemci</label>
                            <input asp-for="SystemRequirement.RecommendedProcessor" placeholder="Intel Core i7..." />
                        </div>

                        <div class="form-group">
                            <label>Bellek (RAM)</label>
                            <input asp-for="SystemRequirement.RecommendedMemory" placeholder="16 GB RAM" />
                        </div>

                        <div class="form-group">
                            <label>Ekran Kartı</label>
                            <input asp-for="SystemRequirement.RecommendedGraphics" placeholder="RTX 3070..." />
                        </div>

                        <div class="form-group">
                            <label>Depolama</label>
                            <input asp-for="SystemRequirement.RecommendedStorage" placeholder="70 GB SSD" />
                        </div>

                    </div>
                </div>

            </div>
        </section>

        <!-- Buttonlar -->
        <div class="form-footer">

            <p>Değişikliklerini kaydetmeyi unutma.</p>

            <div class="footer-buttons">

                <a asp-area="Admin" asp-controller="Games" asp-action="Index" class="form-button cancel-button">
                    İptal
                </a>

                <button type="submit" class="form-button save-button">
                    Değişiklikleri Kaydet
                </button>

            </div>
        </div>

    </form>
    
</div>

<script>
    function setupMultiPicker(config) {
        const source = document.getElementById(config.sourceId);
        const search = document.getElementById(config.searchId);
        const optionsContainer = document.getElementById(config.optionsId);
        const selectedContainer = document.getElementById(config.selectedId);

        if (!source || !search || !optionsContainer || !selectedContainer) {
            return;
        }

        function render() {
            const searchValue = search.value.toLocaleLowerCase("tr-TR");
            const options = Array.from(source.options);

            optionsContainer.innerHTML = "";
            selectedContainer.innerHTML = "";

            const filteredOptions = options.filter(option =>
                option.textContent.toLocaleLowerCase("tr-TR").includes(searchValue)
            );

            if (filteredOptions.length === 0) {
                const emptyMessage = document.createElement("div");
                emptyMessage.className = "picker-empty";
                emptyMessage.textContent = options.length === 0
                    ? "Henüz kayıtlı seçenek bulunmuyor."
                    : "Aramana uygun seçenek bulunamadı.";
                optionsContainer.appendChild(emptyMessage);
            }

            filteredOptions.forEach(option => {
                const button = document.createElement("button");
                button.type = "button";
                button.className = "picker-option";
                button.textContent = option.textContent;
                button.setAttribute("aria-pressed", option.selected ? "true" : "false");

                if (option.selected) {
                    button.classList.add("selected");
                }

                button.addEventListener("click", () => {
                    option.selected = !option.selected;
                    render();
                    search.focus();
                });

                optionsContainer.appendChild(button);
            });

            options.filter(option => option.selected).forEach(option => {
                const chip = document.createElement("div");
                chip.className = "picker-chip";

                const name = document.createElement("span");
                name.textContent = option.textContent;

                const removeButton = document.createElement("button");
                removeButton.type = "button";
                removeButton.textContent = "×";
                removeButton.title = "Seçimi kaldır";
                removeButton.setAttribute("aria-label", option.textContent + " seçimini kaldır");

                removeButton.addEventListener("click", () => {
                    option.selected = false;
                    render();
                });

                chip.append(name, removeButton);
                selectedContainer.appendChild(chip);
            });

            if (!options.some(option => option.selected)) {
                const emptySelected = document.createElement("div");
                emptySelected.className = "picker-empty";
                emptySelected.textContent = "Henüz seçim yapılmadı.";
                selectedContainer.appendChild(emptySelected);
            }
        }

        search.addEventListener("input", render);
        render();
    }

    setupMultiPicker({
        sourceId: "genreSelectSource",
        searchId: "genreSearch",
        optionsId: "genreOptions",
        selectedId: "selectedGenres"
    });

    setupMultiPicker({
        sourceId: "tagSelectSource",
        searchId: "tagSearch",
        optionsId: "tagOptions",
        selectedId: "selectedTags"
    });
</script>

