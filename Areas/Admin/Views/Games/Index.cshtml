
@model IEnumerable<RUNE.Models.Game>
@{
    ViewData["Title"] = "Oyun Yönetimi";
}


<style>
    .games-page {
        max-width: none;
        min-height: 100vh;
        margin: 0;
        padding: 40px;
        background: #0b0b0b;
        color: #f5f5f5;
        font-family: Arial, sans-serif;
    }

    .games-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 32px;
    }

    .games-header h2 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #fff;
    }

    .games-header p {
        color: #999;
        font-size: 14px;
        margin: 0;
    }

    .add-game-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 13px 21px;
        background: #fff;
        color: #111;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        transition: .2s;
        white-space: nowrap;
    }

    .games-table-container {
        overflow-x: auto;
        border: 1px solid #292929;
        border-radius: 12px;
        background: #141414;
    }

    .games-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 750px;
    }

    .games-table thead {
        background: #1c1c1c;
    }

    .games-table th {
        padding: 19px 22px;
        text-align: left;
        font-size: 12px;
        font-weight: 700;
        color: #aaa;
        text-transform: uppercase;
        letter-spacing: .7px;
    }

    .games-table td {
        padding: 20px 22px;
        border-top: 1px solid #292929;
        font-size: 14px;
        color: #ccc;
    }

    .games-table tbody tr {
        transition: background .2s;
    }

    .games-table tbody tr:hover {
        background: #202020;
    }

    .game-title {
        font-weight: 650;
        color: #fff;
    }

    .game-price {
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
    }

    .game-status {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-published {
        color: #8be0aa;
        background: #173323;
    }

    .status-hidden {
        color: #bbb;
        background: #303030;
    }

    .game-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        white-space: nowrap;
    }

    .action-btn {
        padding: 8px 13px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: .2s;
    }

    .edit-btn {
        background: #303030;
        color: #fff;
    }

    .edit-btn:hover {
        background: #454545;
        color: #fff;
    }

    .delete-btn {
        background: #3b1c1c;
        color: #ff7777;
    }

    .delete-btn:hover {
        background: #672323;
        color: #fff;
    }

    .empty-state {
        text-align: center;
        padding: 75px 20px;
        color: #999;
    }

    .empty-state h3 {
        font-size: 20px;
        color: #fff;
        margin-bottom: 10px;
    }

    .empty-state p {
        font-size: 14px;
    }

    .game-info {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 220px;
    }

    .game-cover-placeholder {
        width: 82px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: #292929;
        color: #888;
    }

    .game-cover {
        width: 82px;
        height: 46px;
        object-fit: cover;
        border-radius: 6px;
        background: #292929;
        border: 1px solid #333;
    }

    @@media (max-width: 650px) {
        .games-page {
            padding: 22px 15px;
        }

        .games-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>


<div class="games-page">

    <div class="games-header">
        <div>
            <h2>Oyun Yönetimi</h2>
            <p>Rune mağazasındaki oyunları yönet.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Games"
           asp-action="Create"
           class="add-game-btn">
            Yeni Oyun Ekle
        </a>
    </div>

    <div class="games-table-container">

        @if (Model != null && Model.Any())
        {
            <table class="games-table">
                <thead>
                    <tr>
                        <th>Oyun Adı</th>
                        <th>Fiyat</th>
                        <th>Geliştirici</th>
                        <th>Yayıncı</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var game in Model)
                    {
                        <tr>
                            <td>
                                    <div class="game-info">
                                        @if (!string.IsNullOrWhiteSpace(game.CoverImagePath))
                                        {
                                            <img src="@game.CoverImagePath"
                                                alt="@game.Title"
                                                class="game-cover" />
                                        }
                                        else
                                        {
                                            <div class="game-cover-placeholder">
                                                <icon-placeholder></icon-placeholder>
                                                🎮
                                            </div>
                                        }
                                        <span class="game-name">@game.Title</span>
                                    </div>
                                </td>

                            <td>
                                <span class="game-price">
                                    @game.Price.ToString("N2") ₺
                                </span>
                            </td>

                            <td>@game.Developer</td>

                            <td>@game.Publisher</td>

                            <td>
                                @if (game.IsPublished)
                                {
                                    <span class="game-status status-published">
                                        Yayında
                                    </span>
                                }
                                else
                                {
                                    <span class="game-status status-hidden">
                                        Taslak
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="game-actions">
                                    <a asp-area="Admin"
                                        asp-controller="Games"
                                        asp-action="Edit"
                                       class="action-btn edit-btn">
                                        <img src="https://img.icons8.com/?size=100&id=114092&format=png&color=ffffff" alt="edit" height="18px" width="18px">
                                    </a>

                                    <button type="button"
                                        class="action-btn delete-btn">
                                        <img src="https://img.icons8.com/?size=100&id=78581&format=png&color=FF7F7F " height="19px" width="18px"></img>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <h3>Henüz oyun eklenmemiş.</h3>
                <p>Rune mağazasına ilk oyununu ekleyerek başlayabilirsin.</p>
            </div>
        }

    </div>
</div>
