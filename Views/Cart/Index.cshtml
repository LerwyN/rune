@using System.Globalization
@using RUNE.Models.Entities
@model List<CartItem>
@{
    ViewData["Title"] = "Alışveriş Sepeti";
    var tr = new CultureInfo("tr-TR");
    var total = Model.Sum(i => i.Game.Price);
}


<nav class="game-breadcrumb mt-3" aria-label="Gezinti yolu">
    <a asp-controller="Home" asp-action="Index">Mağaza</a>
    <span aria-hidden="true">></span>
    <span aria-current="page"> Alışveriş Sepetiniz<span> (@Model.Count öğe)</span></span>
</nav>

<div class="cart-page">
    <h4 class="cart-title fw-bold">Sepetim</h4>
</div>

<div class="cart-page">
    @if (!Model.Any())
    {
        <div class="cart-empty">
            <h5>Sepetin şu an boş.</h5>
            <p class="warning-text">Henüz Sepetinize bir oyun eklemediniz. Mağazamıza göz atın ve oynamak istediğiniz oyunları keşfedin!</p>
            <a asp-controller="Home" asp-action="Index" class="cart-btn-secondary">Mağazaya Göz At</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                @foreach (var item in Model)
                {
                    <div class="cart-item">
                        <img class="cart-item-cover" src="@item.Game.CoverImagePath" alt="@item.Game.Title" />

                        <div class="cart-item-info">
                            <div class="cart-item-top">
                                <div>
                                    <span class="cart-badge">Ana Oyun</span>
                                    <h2 class="cart-item-name">@item.Game.Title</h2>
                                </div>
                                <div class="cart-item-price">
                                    @(item.Game.Price == 0 ? "Ücretsiz" : item.Game.Price.ToString("C0", tr))
                                </div>
                            </div>

                            <div class="cart-item-actions">
                                <form asp-controller="Cart" asp-action="Remove" method="post">
                                    <input type="hidden" name="gameId" value="@item.GameId" />
                                    <button type="submit" class="cart-btn-link">Kaldır</button>
                                </form>
                                <button type="button" class="cart-btn-outline">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                         fill="none" stroke="#FFFFFF" stroke-width="1.25" stroke-linecap="round"
                                         stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-gift">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path
                                        d="M3 9a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1l0 -2" />
                                        <path d="M12 8l0 13" />
                                        <path d="M19 12v7a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-7" />
                                        <path
                                        d="M7.5 8a2.5 2.5 0 0 1 0 -5a4.8 8 0 0 1 4.5 5a4.8 8 0 0 1 4.5 -5a2.5 2.5 0 0 1 0 5" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }
                <a class="cart-btn-secondary shopping-go" asp-controller="Home" asp-action="Index" class="btn-secondary">Alışverişe Devam Et</a>
            </div>

            <aside class="cart-summary">
                <h2>Sipariş Özeti</h2>

                <div class="cart-summary-row">
                    <span>Fiyat</span>
                    <span>@total.ToString("C2", tr)</span>
                </div>
                <div class="cart-summary-row">
                    <span>Vergiler</span>
                    <span class="cart-summary-note">Ödeme sırasında hesaplanır</span>
                </div>
                <div class="cart-summary-row cart-summary-total">
                    <span>Toplam</span>
                    <span>@total.ToString("C2", tr)</span>
                </div>

                <button type="button" class="cart-btn-primary">Ödeme Yap</button>
            </aside>
        </div>
    }
</div>
